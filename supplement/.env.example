# Copy to .env and fill in. Nothing here has a default that works out of the box --
# every credential was stripped from the source before release.

# ---------------------------------------------------------------- paths
# Repository of rendered pages, OCR text and the page/text indices.
VLDR_ROOT=/path/to/vldr
VLDR_CORPUS=
VLDR_DOCMAP=
# Pre-packed index (a single .npz of page vectors). Without it the loader falls back
# to per-document directories, which is correct but very slow on a large corpus.
IDX_PACKED=
VLDR_USE_NPZ=1
# Benchmark file the run driver reads its questions from.
VLDR_BENCH=

# ---------------------------------------------------------------- which agent
# react_chat.py is the multi-turn harness used for every number in the paper.
# The older single-turn react.py is not included.
HARNESS=chat
AGENT_MODEL=qwen3-27b-local
CONCURRENCY=12
BUDGET_USD=100
AGENT_MAX_RETRIES=6

# ---------------------------------------------------------------- self-hosted Qwen
# Served with SGLang, tensor-parallel over 4 GPUs. Sampling follows the model card.
QWEN_HOST=127.0.0.1
QWEN_PORT=8000
QWEN_SERVED=qwen3-27b
QWEN_TEMP=0.6
QWEN_TOP_P=0.95
QWEN_TOP_K=20
QWEN_PRES_PEN=1.0
QWEN_MAX_TOKENS=
QWEN_THINK=1
QWEN_SEED=0

# ---------------------------------------------------------------- page rendering
# 0 = no cap, i.e. full resolution. Capping this is the "low-res" setting in the
# cost/accuracy figure; it changes results, so set it deliberately.
IMG_MAX_PIXELS=0

# ---------------------------------------------------------------- API backends
# Only needed to reproduce the proprietary baselines. The open-weight pipeline
# needs none of these.
GPT54_URL=
GPT54_KEY=
AZURE_RESPONSES_URL_A=
AZURE_RESPONSES_URL_B=
AZURE_KEY_A=
AZURE_KEY_B=
AZURE_GROK_URL_A=
AZURE_GROK_URL_B=
AZURE_KEY_GROK=
TOGETHER_API_KEY=
# Gemini via Vertex AI
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=

# ---------------------------------------------------------------- query rewriting
# Optional rewriting stage in front of the retriever; off unless REWRITE_MODEL is set.
REWRITE_MODEL=
REWRITE_STYLE=
REWRITE_WORDS=
REWRITE_EFFORT=
